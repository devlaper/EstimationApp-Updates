<Window x:Class="EstimationApp.CommonReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Preview &amp; Filter" Height="720" Width="1200" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, sans-serif"
        Icon="estimate_icon-removebg-preview.ico"
        Background="#F4F5F7"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Filter & Math Controls -->
        <Border Grid.Column="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Fees -->
                    <RowDefinition Height="*"/>
                    <!-- Scrollable Filter Area -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Percentage Inputs (Hidden for Measurement Reports) -->
                <StackPanel x:Name="PanelFees" Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Project Fees &amp; Taxes" FontWeight="Bold" Margin="0,0,0,10" Foreground="#555555"/>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="GST (%):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtGst" Text="18" Width="60" HorizontalAlignment="Right" TextChanged="FeeInput_TextChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Structural Consultant (%):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtStructFee" Text="0" Width="60" HorizontalAlignment="Right" TextChanged="FeeInput_TextChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Architectural Consultant (%):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtArchFee" Text="0" Width="60" HorizontalAlignment="Right" TextChanged="FeeInput_TextChanged"/>
                    </Grid>
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"/>
                </StackPanel>

                <!-- Scrollable Filter Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel>

                        <!-- 1. FLAT GLOBAL FILTER -->
                        <TextBlock Text="1. Global Rule Filters (Fast)" FontWeight="Bold" Margin="0,5,0,5" Foreground="#555555"/>
                        <ComboBox x:Name="ComboParameter" Height="30" Padding="5" Margin="0,0,0,10" SelectionChanged="ComboParameter_SelectionChanged">
                            <ComboBoxItem Content="Building Name" IsSelected="True"/>
                            <ComboBoxItem Content="Floor Name"/>
                            <ComboBoxItem Content="Work Name"/>
                            <ComboBoxItem Content="Item Name"/>
                        </ComboBox>

                        <ListBox x:Name="ListFilterOptions" Height="100" Margin="0,0,0,10" BorderBrush="#DDDDDD">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="Add to Active Filters" Height="30" Background="#E6F2FF" Foreground="#005A9E" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand" Click="BtnAddFilter_Click"/>

                        <ListBox x:Name="ListActiveFilters" Height="70" Background="#F9F9F9" BorderThickness="0" Margin="0,0,0,15" KeyDown="ListActiveFilters_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Foreground="#C00000" FontWeight="SemiBold" Margin="0,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 2. HIERARCHICAL TREE FILTER -->
                        <TextBlock Text="2. Advanced Tree Filters (Specific)" FontWeight="Bold" Margin="0,0,0,5" Foreground="#555555"/>
                        <TreeView x:Name="TreeFilters" Height="250" BorderThickness="1" BorderBrush="#E0E0E0" Background="#FBFBFB" Margin="0,0,0,10">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="True" VerticalAlignment="Center" Cursor="Hand"/>
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <CheckBox x:Name="ChkShowDescriptions" Content="Show Item Descriptions" IsChecked="True" 
          Foreground="#4B5563" FontWeight="SemiBold" Margin="0,10,0,10" Cursor="Hand" 
          Checked="ChkShowDescriptions_Changed" Unchecked="ChkShowDescriptions_Changed"/>

                        <Button Content="Clear All Filters" Height="25" Background="Transparent" Foreground="#888888" BorderThickness="0" Cursor="Hand" Click="BtnClearFilters_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2">
                    <Button Content="Apply Filters &amp; Refresh Preview" Height="35" Background="#111111" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand" Click="BtnGeneratePreview_Click"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Export to PDF" Height="40" Background="#005A9E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnExportPdf_Click"/>
                        <Button Grid.Column="2" x:Name="BtnExportExcel" Content="Export Excel (CSV)" Height="40" Background="#1E8449" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnExportExcel_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Panel: PDF Viewer -->
        <Grid Grid.Column="1" Background="#525659">
            <wv2:WebView2 x:Name="PdfViewer" />
        </Grid>
    </Grid>
</Window>