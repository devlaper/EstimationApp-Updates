<Window x:Class="EstimationApp.CombineProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Combine Buildings" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7" FontFamily="Segoe UI, Helvetica, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="COMBINE BUILDINGS FROM MULTIPLE SOURCES" FontSize="16" FontWeight="Bold" Foreground="#33333C"/>
            <TextBlock Text="Select .est or .accdb files. The buildings inside them will appear below. Remove any buildings you don't want to import." FontSize="12" Foreground="#888890" Margin="0,2,0,10" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="+ Add Files (.est, .accdb)" Width="180" Height="35" Background="#005A9E" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnAddFiles_Click"/>
                <Button Content="Remove Selected Building" Width="180" Height="35" Background="Transparent" Foreground="#C00000" FontWeight="SemiBold" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" Click="BtnRemoveBuilding_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Building Roster -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="GridBuildings" AutoGenerateColumns="False" CanUserAddRows="False" 
                      BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9F9FB" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" HeadersVisibility="Column" RowHeight="35">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F5F7"/>
                        <Setter Property="Foreground" Value="#666666"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Building Name" Binding="{Binding BuildingName}" Width="250" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#111111"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn Header="Qty" Binding="{Binding NumberOfBuildings}" Width="60" IsReadOnly="True" >
                        <DataGridTextColumn.ElementStyle>
                                 <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#111111"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                 </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Source File" Binding="{Binding FileName}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Button Content="Combine and Open Workspace" Height="40" Background="#387C44" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnCombine_Click"/>
        </Grid>
    </Grid>
</Window>