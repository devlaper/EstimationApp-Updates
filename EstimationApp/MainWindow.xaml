<Window x:Class="EstimationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estimation Engine" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Helvetica, Segoe UI, sans-serif"
        Icon="estimate_icon-removebg-preview.ico"
        Background="#F7F7F9">

    <!-- The main layout grid -->
    <Grid>
        <!-- Center the content in the middle of the screen -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="350" Margin="0,110,0,0">

            <!-- Typography: Main Title -->
            <TextBlock Text="ESTIMATION ENGINE" 
                       FontSize="22" 
                       FontWeight="SemiBold" 
                       Foreground="#222222" 
                       TextAlignment="Center" 
                       Margin="0,0,0,8"/>

            <!-- Typography: Subtitle -->
            <TextBlock Text="Select a workspace to begin." 
                       FontSize="14" 
                       Foreground="#666666" 
                       TextAlignment="Center" 
                       Margin="0,0,0,45"/>

            <!-- Create New Project Button (Primary Action) -->
            <Button x:Name="BtnCreateProject" 
                    Content="Create New Project" 
                    Height="50" 
                    Margin="0,0,0,15" 
                    Background="#111111" 
                    Foreground="White" 
                    FontSize="14" 
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnCreateProject_Click"/>

            <!-- Open Existing Project Button (Secondary Action) -->
            <Button x:Name="BtnOpenProject" 
                    Content="Open Existing File" 
                    Height="50" 
                    Background="White" 
                    Foreground="#111111" 
                    FontSize="14" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnOpenProject_Click"/>

            <Button x:Name="BtnImportDatabase" 
                    Content="Import Master Database (.accdb)" 
                    Height="50" 
                    Background="Transparent" 
                    Foreground="#111111" 
                    FontSize="14" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,15,0,0"
                    Click="BtnImportDatabase_Click"/>

            <Button Content="Combine Projects..." 
                            Height="50" 
                            
                            Background="#111111" 
                            Foreground="White" 
                            FontSize="14" 
                            BorderThickness="0"
                    Margin="0,15,0,0"
                    Click="BtnOpenCombineWindow_Click"/>

        </StackPanel>
    </Grid>
</Window>