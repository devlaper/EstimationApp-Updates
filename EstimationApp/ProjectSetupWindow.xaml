<Window x:Class="EstimationApp.ProjectSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Setup" Height="780" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        Icon="estimate_icon-removebg-preview.ico"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Style for all DataGrids -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header Card -->
            <RowDefinition Height="*"/>
            <!-- Main Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Button -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header Card -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Project Configuration" FontSize="22" FontWeight="Bold" Foreground="#1E1E24" Margin="0,0,0,15"/>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <!-- Project Name -->
                    <StackPanel Margin="0,0,25,10">
                        <TextBlock Text="Project Name" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB" Height="34">
                            <TextBox x:Name="TxtProjectName" Width="220" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Owner Name -->
                    <StackPanel Margin="0,0,25,10">
                        <TextBlock Text="Owner Name" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB" Height="34">
                            <TextBox x:Name="TxtOwnerName" Width="180" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Ref No -->
                    <StackPanel Margin="0,0,25,10">
                        <TextBlock Text="Ref No" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB" Height="34">
                            <TextBox x:Name="TxtRefNo" Width="100" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Budget -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Project Budget (₹)" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB" Height="34">
                            <TextBox x:Name="TxtBudget" Width="140" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Row 1: Main Content 3-Column Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <!-- Col 0: Buildings (Full Height) -->
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="2.5*"/>
                <!-- Col 2: Rooms, Markers, Vars -->
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="5*"/>
                <!-- Col 4: Material Tests -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Buildings List (Massive vertical space) -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Buildings" FontWeight="Bold" FontSize="16" Foreground="#1E1E24" Margin="0,0,0,10"/>
                    <DataGrid x:Name="GridBuildings" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CellEditEnding="Grid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Building Name" Binding="{Binding BuildingName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding NumberOfBuildings}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- MIDDLE COLUMN: Stacked Settings -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>

                <!-- Rooms -->
                <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Rooms" FontWeight="Bold" FontSize="16" Foreground="#1E1E24" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridRooms" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CellEditEnding="Grid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Room Name" Binding="{Binding RoomName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Color Markers -->
                <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Color Markers" FontWeight="Bold" FontSize="16" Foreground="#1E1E24" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridMarkers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CellEditEnding="Grid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Marker Name" Binding="{Binding MarkerName}" Width="*"/>
                                <DataGridTemplateColumn Header="Color" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding MarkerColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" BorderThickness="0" Background="Transparent">
                                                <ComboBoxItem Content="None" Tag="Transparent" />
                                                <ComboBoxItem Content="Red" Tag="#FF5252" Background="#FF5252" Foreground="White"/>
                                                <ComboBoxItem Content="Green" Tag="#4CAF50" Background="#4CAF50" Foreground="White"/>
                                                <ComboBoxItem Content="Blue" Tag="#2196F3" Background="#2196F3" Foreground="White"/>
                                                <ComboBoxItem Content="Yellow" Tag="#FFEB3B" Background="#FFEB3B"/>
                                                <ComboBoxItem Content="Orange" Tag="#FF9800" Background="#FF9800"/>
                                                <ComboBoxItem Content="Purple" Tag="#9C27B0" Background="#9C27B0" Foreground="White"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Custom Variables -->
                <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Custom Variables" FontWeight="Bold" FontSize="16" Foreground="#1E1E24" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridVariables" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name (e.g. 'a')" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: Material Tests (Full Height) -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Material Testing Requirements" FontWeight="Bold" FontSize="16" Foreground="#1E1E24" Margin="0,0,0,10"/>
                    <DataGrid x:Name="GridMaterialTests" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="1.5*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#005A9E"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Margin" Value="0,5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Rate (₹)" Binding="{Binding Rate, StringFormat=N2}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Save Button -->
        <Border Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Right" CornerRadius="6" Background="#005A9E">
            <Button Content="Save Configuration" Width="180" Height="40" Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSaveContinue_Click"/>
        </Border>
    </Grid>
</Window>