<Window x:Class="EstimationApp.WorkEnvironmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EstimationApp"
        Title="Estimation Workspace" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Helvetica, Segoe UI, sans-serif"
        Background="#F4F5F7" x:Name="AppWindow"
        PreviewKeyDown="Window_PreviewKeyDown" 
        PreviewMouseWheel="Window_PreviewMouseWheel" 
        WindowState="Maximized"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <!-- NEW: Sleek, Minimal Modern Scrollbars -->
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Border Background="Transparent" />
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="4" Background="#888888" Opacity="0.5" Margin="2,0,0,0"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Border Background="Transparent" />
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="false" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="4" Background="#888888" Opacity="0.5" Margin="0,2,0,0"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="false" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="260" MaxWidth="600"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Dark Navigation Sidebar -->
        <Border Grid.Column="0" Background="#1E1E24" Padding="15,20,15,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PROJECT EXPLORER" Foreground="#888890" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" x:Name="BtnExpandExplorer" Content="⤢" ToolTip="Expand to Full Screen" Background="Transparent" Foreground="#888890" BorderThickness="0" Cursor="Hand" Click="BtnExpandExplorer_Click" FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button x:Name="BtnToggleView" Content="⮂ By Building" Background="Transparent" Foreground="#5DA2FF" BorderThickness="0" Cursor="Hand" Click="BtnToggleView_Click" FontSize="11" FontWeight="Bold" Grid.ColumnSpan="2" Margin="176,0,38,0"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBox x:Name="TxtSearchExplorer" Padding="10,8" Background="#2D2D36" Foreground="White" BorderThickness="0" FontSize="13" TextChanged="TxtSearchExplorer_TextChanged"/>
                    <TextBlock x:Name="TxtSearchWatermark" Text="Search explorer..." Foreground="#888890" FontSize="13" FontStyle="Italic" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <TreeView x:Name="TreeContext" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          PreviewKeyDown="TreeContext_PreviewKeyDown">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsActiveNode, Mode=TwoWay}"/>
                            <!-- CRITICAL FIX: Binds expansion to the model instead of forcing it globally -->
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>

                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>

                            <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                            <EventSetter Event="Collapsed" Handler="TreeViewItem_Collapsed"/>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Transparent"/>

                        <!-- Template for Standard Mode (Sort by Item) -->
                        <HierarchicalDataTemplate DataType="{x:Type local:WorkItemEntry}" ItemsSource="{Binding Sheets}">
                            <!-- Reverted BorderThickness to 1 -->
                            <Border x:Name="NodeBorder" Background="Transparent" MouseLeftButtonUp="Node_MouseLeftButtonUp" CornerRadius="4" Margin="0,2,10,2" Padding="5,3" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
                                <TextBlock x:Name="NodeText" TextWrapping="Wrap" Opacity="0.5">
                            <!-- NEW: Text Foreground is bound to MarkerColor. Falls back to White if null or None -->
                            <Run Text="{Binding DisplayWorkName}" FontWeight="Bold" Foreground="{Binding Sheets[0].MarkerColor, TargetNullValue=White, FallbackValue=White}"/>
                            <Run Text=" - " Foreground="#888888"/>
                            <Run Text="{Binding UIItemName, Mode=OneWay}" FontWeight="Normal" Foreground="#AAAAAA"/>
                                </TextBlock>
                            </Border>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActiveNode}" Value="True">
                                    <Setter TargetName="NodeBorder" Property="Background" Value="#2D2D36"/>
                                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#5DA2FF"/>
                                    <Setter TargetName="NodeText" Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasData}" Value="True">
                                    <Setter TargetName="NodeText" Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type local:MeasurementSheet}">
                            <!-- Reverted BorderThickness to 1 -->
                            <Border x:Name="SheetBorder" Background="Transparent" MouseLeftButtonUp="Node_MouseLeftButtonUp" CornerRadius="4" Margin="0,2,10,2" Padding="5,3" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
                                <!-- NEW: Foreground bound to MarkerColor. Falls back to grey (#B0B0B8) -->
                                <TextBlock x:Name="SheetText" Text="{Binding DisplayName}" Foreground="{Binding MarkerColor, TargetNullValue=#B0B0B8, FallbackValue=#B0B0B8}" TextWrapping="Wrap" Opacity="0.5"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActiveNode}" Value="True">
                                    <Setter TargetName="SheetBorder" Property="Background" Value="#2D2D36"/>
                                    <Setter TargetName="SheetBorder" Property="BorderBrush" Value="#5DA2FF"/>
                                    <Setter TargetName="SheetText" Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasData}" Value="True">
                                    <Setter TargetName="SheetText" Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- Template for Building Group Mode -->
                        <HierarchicalDataTemplate DataType="{x:Type local:TreeBuildingGroup}" ItemsSource="{Binding Floors}">
                            <TextBlock Text="{Binding BuildingName}" Foreground="#FFD700" FontWeight="SemiBold" Margin="6,6,15,6" TextWrapping="Wrap"/>
                        </HierarchicalDataTemplate>

                        <!-- Template for Floor Subheaders -->
                        <HierarchicalDataTemplate DataType="{x:Type local:TreeFloorGroup}" ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding FloorName}" Foreground="#A0A0A0" FontWeight="SemiBold" Margin="6,4,15,4" TextWrapping="Wrap"/>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type local:TreeWorkItemGroup}">
                            <!-- Reverted BorderThickness to 1 -->
                            <Border x:Name="NodeBorder" Background="Transparent" MouseLeftButtonUp="Node_MouseLeftButtonUp" CornerRadius="4" Margin="0,2,10,2" Padding="5,3" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
                                <TextBlock x:Name="NodeText" TextWrapping="Wrap" Opacity="0.5">
                            <!-- NEW: Text Foreground is bound to MarkerColor. Falls back to White if null or None -->
                            <Run Text="{Binding DisplayWorkName}" FontWeight="Bold" Foreground="{Binding OriginalSheet.MarkerColor, TargetNullValue=White, FallbackValue=White}"/>
                            <Run Text=" - " Foreground="#888888"/>
                            <Run Text="{Binding UIItemName, Mode=OneWay}" FontWeight="Normal" Foreground="#AAAAAA"/>
                                </TextBlock>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActiveNode}" Value="True">
                                    <Setter TargetName="NodeBorder" Property="Background" Value="#2D2D36"/>
                                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#5DA2FF"/>
                                    <Setter TargetName="NodeText" Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OriginalSheet.HasData}" Value="True">
                                    <Setter TargetName="NodeText" Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <Border x:Name="MeterBorder" Grid.Row="3" Background="#2D2D36" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="LIVE PROJECT COST" Foreground="#888890" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel x:Name="PanelGrandTotalMeter">
                            <TextBlock x:Name="TxtLiveGrandTotal" Text="₹ 0.00" Foreground="#5DA2FF" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtGrandTotalPercent" Text="(0% of Budget)" Foreground="#A0A0A0" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListLiveBuildingCosts" Visibility="Collapsed" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6">
                                            <TextBlock Text="{Binding BuildingName}" Foreground="#888890" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TotalCost, StringFormat=₹ {0:N2}}" Foreground="#5DA2FF" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding PercentageText}" Foreground="#A0A0A0" FontSize="12" Margin="8,0,0,2" VerticalAlignment="Bottom" Visibility="{Binding PercentageVisibility}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Button Grid.Row="4" x:Name="BtnNewItem" Content="+ Add New Work Item" Background="#2D2D36" Foreground="White" BorderThickness="0" Height="42" Margin="0,15,0,0" Cursor="Hand" Click="BtnNewItem_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- DRAGGABLE SPLITTER -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D5D5D5" Cursor="SizeWE"/>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="2" x:Name="RightPanelBackground" Background="#F4F5F7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- MENU BAR -->
            <Menu x:Name="MenuBar" Grid.Row="0" Background="White" Padding="10,5" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
                <MenuItem Header="_File" Foreground="#333333" x:Name="MenuFile">
                    <MenuItem Header="Open Project" Click="MenuOpen_Click"/>
                    <MenuItem Header="Import File..." Click="MenuImport_Click"/>
                    <MenuItem Header="Save Project" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                    <MenuItem Header="Save As..." InputGestureText="Ctrl+Shift+S" Click="MenuSaveAs_Click"/>
                    <MenuItem Header="Close Project" Click="MenuCloseProject_Click"/>
                    <Separator/>
                    <MenuItem Header="Update Master Database" Click="MenuUpdateDB_Click"/>
                </MenuItem>
                <MenuItem Header="_View" Foreground="#333333" x:Name="MenuView">
                    <MenuItem Header="Toggle Dark Mode" Click="MenuDarkMode_Click"/>
                </MenuItem>
            </Menu>

            <!-- HEADER -->
            <StackPanel Grid.Row="1" Margin="40,30,40,20">
                <Border x:Name="SearchBorder" Background="White" CornerRadius="6" BorderBrush="#DDDDDD" BorderThickness="1" Padding="5,2" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Search Master Item:" Foreground="#999999" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <Button x:Name="BtnOpenSearch" Grid.Column="1" Height="38" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand" Click="BtnOpenSearch_Click">
                            <TextBlock x:Name="TxtSearchDisplay" Text="Click here to search and select an item..." Foreground="#111111" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- DSR & Rate Tags -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Border Background="#E6F2FF" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DSR: " Foreground="#005A9E" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="LblDsrCode" Foreground="#005A9E" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F2F1" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rate: ₹" Foreground="#323130" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="LblRate" Foreground="#323130" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text=" / " Foreground="#323130" FontSize="12"/>
                            <TextBlock x:Name="LblUnit" Foreground="#323130" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TYPOGRAPHY HIERARCHY -->
                <TextBlock x:Name="LblWorkName" Text="Select a Work Group..." FontSize="28" FontWeight="Light" Foreground="#111111" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="LblItemName" Text="Item Name" FontSize="20" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock x:Name="LblSubItem" Text="Sub Item Name" FontSize="16" Foreground="#555555" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Description -->
                <TextBlock x:Name="LblDescription" FontSize="14" Foreground="#888888" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,25" LineHeight="20"/>

                <!-- Dropdowns -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock x:Name="LblLocation" Text="Location:" VerticalAlignment="Center" Foreground="#888888" FontWeight="SemiBold" Margin="0,0,12,0"/>

                    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White" Margin="0,0,10,0">
                        <ComboBox x:Name="ComboBuilding" Width="140" Height="34" Padding="8,6" BorderThickness="0" Background="Transparent" SelectedItem="{Binding BuildingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="ComboLocation_SelectionChanged"/>
                    </Border>
                    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White" Margin="0,0,10,0">
                        <xctk:CheckComboBox x:Name="ComboMultiFloors" 
                            Width="154" 
                            HorizontalAlignment="Left" 
                            Delimiter=", "
                            ItemSelectionChanged="ComboMultiFloors_ItemSelectionChanged" />
                    </Border>
                    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White" Margin="0,0,10,0">
                        <ComboBox x:Name="ComboMarker" Width="140" Height="34" Padding="8,6" BorderThickness="0" Background="Transparent" SelectedItem="{Binding MarkerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="White">
                        <ComboBox x:Name="ComboRoom" Width="140" Height="34" Padding="8,6" BorderThickness="0" Background="Transparent" SelectedItem="{Binding RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>

                    <Button Content="+ Add Row" Width="120" Height="34" Background="#E6F2FF" Foreground="#005A9E" FontWeight="Bold" BorderThickness="0" Margin="15,0,0,0" Cursor="Hand" Click="BtnAddMeasurement_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Edit Locations" Width="100" Height="34" Background="Transparent" Foreground="#888888" FontWeight="SemiBold" BorderThickness="0" Margin="5,0,0,0" Cursor="Hand" Click="BtnNewBuilding_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- MEASUREMENT GRID -->
            <Border Grid.Row="2" Background="White" Margin="40,0,40,0" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <DataGrid x:Name="GridMeasurements" AutoGenerateColumns="False" CanUserAddRows="True" 
                  BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9F9FB" 
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#EEEEEE" VerticalGridLinesBrush="#EEEEEE" 
                  HeadersVisibility="All" RowHeight="45" FontSize="14"
                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader"
                  CellEditEnding="GridMeasurements_CellEditEnding"
                  PreviewKeyDown="GridMeasurements_PreviewKeyDown">

                    <!-- Adds the Excel-style row selectors on the left side -->
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="DataGridRowHeader">
                            <Setter Property="Width" Value="25"/>
                            <Setter Property="Background" Value="#F4F5F7"/>
                            <Setter Property="BorderBrush" Value="#E5E5E5"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F4F5F7"/>
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E5E5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Dedicated Right-Click Menu -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Content (Ctrl+C)" Click="MenuCopyContent_Click" />
                            <MenuItem Header="Paste Content (Ctrl+V)" Click="MenuPasteContent_Click" />
                            <MenuItem Header="Clear Content (Del)" Click="MenuClearContent_Click" />
                            <Separator />
                            <MenuItem Header="Copy Entire Row(s)" Click="MenuCopyRow_Click" />
                            <MenuItem Header="Paste Entire Row(s)" Click="MenuPasteRow_Click" />
                            <MenuItem Header="Delete Entire Row(s)" Click="MenuDeleteRow_Click" Foreground="#D83B01" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <!-- YOUR RESTORED COLUMNS -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Remark" Binding="{Binding Remark, TargetNullValue=''}" Width="*"/>
                        <DataGridTextColumn Header="Qty (A)" Binding="{Binding Quantity_A, TargetNullValue=''}" Width="80"/>
                        <DataGridTextColumn Header="Factor" Binding="{Binding Factor, TargetNullValue=''}" Width="70"/>
                        <DataGridTextColumn Header="Nos" Binding="{Binding Nos, TargetNullValue=''}" Width="70"/>
                        <DataGridTextColumn Header="L" Binding="{Binding L,TargetNullValue=''}" Width="70"/>
                        <DataGridTextColumn Header="B" Binding="{Binding B,TargetNullValue=''}" Width="70"/>
                        <DataGridTextColumn Header="H" Binding="{Binding H,TargetNullValue=''}" Width="70"/>
                        <DataGridTextColumn Header="Answer" Binding="{Binding Ans, StringFormat=N3}" IsReadOnly="True" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#005A9E"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- KEEP YOUR EXISTING <DataGrid.Columns> HERE -->
            </Border>



            <!-- FOOTER -->
            <Grid Grid.Row="3" Margin="40,20,40,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Meas. Sheet (Head)" Width="135" Height="42" Background="#387C44" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnGenerateMeasReport_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Meas. Sheet (Item)" Width="135" Height="42" Background="#C00000" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnGenerateItemMeasReport_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Abstract (Head)" Width="135" Height="42" Background="#111111" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnGenerateReport_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Abstract (Item)" Width="135" Height="42" Background="#005A9E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnGenerateItemReport_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- NEW: Split Footer Design -->
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="LblTotalHeader" Text="TOTAL QUANTITY:" Foreground="#888888" FontSize="13" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotal" Text="0.000" Foreground="#111111" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotalUnit" Text="-" Foreground="#888888" FontSize="15" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <TextBlock x:Name="LblCostHeader" Text="SHEET COST:" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>
