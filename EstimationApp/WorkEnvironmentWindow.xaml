                        <TextBlock x:Name="LblItemCost" Text="0.00" Foreground="#5DA2FF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
